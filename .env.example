# LOCAL DEVELOPMENT
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DATABASE_URL=sqlite:///db.sqlite3
AGENT_ENROLLMENT_TOKEN=replace-with-a-long-random-enrollment-token

# PRODUCTION (Render + Neon)
# DEBUG=0
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=use-a-unique-long-password
# ADMIN_EMAIL=you@example.com
# RESET_ADMIN_PASSWORD=0
# RENDER_EXTERNAL_HOSTNAME is injected automatically by Render.

SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

# Local demo accounts used by setup_local.ps1 / seed_demo only.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=ChangeThisImmediately!234
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_EMPLOYEE_USERNAME=varun
DEMO_EMPLOYEE_PASSWORD=EmployeeDemo!234
DEMO_EMPLOYEE_EMAIL=varun@example.com
